# CivSimulate Local Development Environment Variables

# Required for AI-powered civilization simulation
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How to reach Anthropic models: api | subscription | auto (default).
# subscription = uses the logged-in `claude` CLI (Claude Code) and bills your
# Claude subscription instead of an API key.
# LLM_BACKEND=auto

# Optional: Required only if you want to use OpenAI models (GPT-4.1, GPT-4.1 Mini, GPT-5.2)
# in competitive mode. Get your API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Session secret (a random string for session encryption)
# If not set, a default development secret will be used
SESSION_SECRET=your_random_session_secret_here

# Note: For local development, the following are NOT required:
# - DATABASE_URL (uses in-memory storage)
# - REPLIT_DOMAINS (uses local auth)
# - ISSUER_URL
# - REPL_ID
